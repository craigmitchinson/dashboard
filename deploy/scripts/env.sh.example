#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# Shared config for deploy/scripts/*.sh. Copy to env.sh (gitignored — it will
# hold no secrets itself, but keeping local overrides out of git avoids
# committing project-specific values by accident) and edit, then every script
# in this directory does `source "$(dirname "$0")/env.sh"`.
#
#   cp deploy/scripts/env.sh.example deploy/scripts/env.sh
#   $EDITOR deploy/scripts/env.sh
#
# Nothing in this file is a secret (the SQL login password and the Elastic/BP
# API credentials are generated/entered interactively by 04_secrets.sh and
# stored in Secret Manager, never here — see that script).
# ---------------------------------------------------------------------------
set -euo pipefail

PROJECT_ID="your-gcp-project-id"
REGION="europe-west2"

# --- Networking (private IP is REQUIRED for SQL Server on Cloud Run — see
# deploy/cloudsql.md's "why private IP" section) ---
NETWORK_NAME="bp-vpc"
SUBNET_NAME="bp-subnet"
SUBNET_RANGE="10.10.0.0/24"
PSA_RANGE_NAME="bp-sql-psa-range"
PSA_RANGE_PREFIX_LENGTH="16"   # /16 reserved for Private Service Access peering

# --- Cloud SQL for SQL Server ---
# EDITION/TIER GUIDANCE (verified — see deploy/cloudsql.md's citations):
#   - Cloud SQL Enterprise edition supports SQL Server Standard/Enterprise/
#     Express/Web (2017 onward) at $0.13/$0.47/$0.00/$0.01134 per core-hour
#     respectively (Standard is the usual production default: full feature
#     set including table partitioning since 2016 SP1, materially cheaper
#     per-core licensing than Enterprise, and this pipeline's workload —
#     row-store OLTP-shaped merges plus a nonclustered columnstore for
#     analytics, see 12_performance.sql — does not need an
#     Enterprise-only engine feature).
#   - Cloud SQL Enterprise Plus edition supports ONLY SQL Server Enterprise
#     — pick this tier only if you specifically need Enterprise Plus's own
#     platform features (e.g. its faster failover / read pool options),
#     not because the database engine edition itself demands it.
SQL_INSTANCE_NAME="bp-analytics-sql"
SQL_DATABASE_VERSION="SQLSERVER_2022_STANDARD"   # see SQLSERVER_* values: gcloud sql instances create --help
SQL_EDITION="ENTERPRISE"                          # ENTERPRISE or ENTERPRISE_PLUS
SQL_TIER="db-custom-4-16384"                      # 4 vCPU / 16GB — right-size for your real row-count target
SQL_STORAGE_SIZE_GB="100"                         # grows automatically; see deploy/cloudsql.md's 64TB ceiling note
SQL_ROOT_PASSWORD_SECRET_NAME="bp-sql-root-password"

SQL_DATABASE_NAME="BPAnalytics"       # matches 01_database_and_schemas.sql
SQL_APP_USER="bp_pipeline_svc"        # the login the ingest job (and, later, the data API) connects as
SQL_APP_PASSWORD_SECRET_NAME="bp-sql-app-password"

# --- Service accounts ---
INGEST_SERVICE_ACCOUNT_NAME="bp-ingest-job"
INGEST_SERVICE_ACCOUNT_EMAIL="${INGEST_SERVICE_ACCOUNT_NAME}@${PROJECT_ID}.iam.gserviceaccount.com"

# --- Ingest Cloud Run Job ---
INGEST_JOB_NAME="bp-ingest-pull"
INGEST_IMAGE="${REGION}-docker.pkg.dev/${PROJECT_ID}/bp-ingest/bp-ingest:latest"
INGEST_SCHEDULE="*/15 * * * *"          # every 15 minutes; see PLAYBOOK.md section 5's scheduling guidance
BP_ADAPTER="elastic"                     # elastic (default) or api — see PLAYBOOK.md section 2

# Secret Manager secret names for the CHOSEN adapter's own credentials —
# create only the ones your adapter needs (see 04_secrets.sh):
ELASTIC_API_KEY_SECRET_NAME="bp-elastic-api-key"
BP_CLIENT_SECRET_SECRET_NAME="bp-api-client-secret"

# --- Alerting (11_alerting.sh) ---
# Where the "ingest run failed" / "no successful pull in 60 minutes" email
# alerts go. Not a secret, but genuinely personal/team data — left blank by
# default, same convention as the other placeholder values in this file.
ALERT_EMAIL=""

# ---------------------------------------------------------------------------
# --- Data API (server/) — Cloud Run SERVICE, see 08_deploy_api.sh ---
# ---------------------------------------------------------------------------
API_SERVICE_NAME="bp-api"
API_IMAGE="${REGION}-docker.pkg.dev/${PROJECT_ID}/bp-api/bp-api:latest"
API_SERVICE_ACCOUNT_NAME="bp-api-svc"
API_SERVICE_ACCOUNT_EMAIL="${API_SERVICE_ACCOUNT_NAME}@${PROJECT_ID}.iam.gserviceaccount.com"

# min-instances=1: avoids a cold start on every first request per idle
# period AND keeps the mssql connection pool warm — Direct VPC egress adds
# its own cold-start latency (a fresh VPC network interface) on top of a
# plain container cold start, which min-instances=0 would otherwise incur
# on every scale-from-zero. Costs ~1 always-on instance; see deploy/gcp.md's
# cost notes.
API_MIN_INSTANCES="1"
API_MAX_INSTANCES="10"
API_CONCURRENCY="40"                    # keep below the mssql pool's own max size per instance
API_LOG_LEVEL="info"
# Only needed if something calls the API's OWN Cloud Run URL directly from a
# browser (bypassing 09/10's routing) — e.g. local frontend dev against the
# deployed API. Leave unset for the default nginx-proxy topology.
API_CORS_ORIGIN=""

# AUTH_MODE=entra is the only value server/src/config.ts permits when this
# runs with NODE_ENV=production (08_deploy_api.sh sets that) — dev/none both
# refuse to start. See deploy/gcp.md's "Entra app registration" section for
# where ENTRA_TENANT_ID/ENTRA_AUDIENCE come from, and its "known gap" note on
# the SPA not yet attaching a Bearer token to its API calls.
AUTH_MODE="entra"
ENTRA_TENANT_ID=""       # Entra (Azure AD) tenant ID, a GUID
ENTRA_AUDIENCE=""        # the API app registration's Application ID URI or client ID that access tokens must be issued for

# ---------------------------------------------------------------------------
# --- Frontend SPA (root Dockerfile) — Cloud Run SERVICE, see
# 09_deploy_frontend.sh (default) / 10_deploy_loadbalancer.sh (production LB) ---
# ---------------------------------------------------------------------------
FRONTEND_SERVICE_NAME="bp-dashboard"
FRONTEND_IMAGE="${REGION}-docker.pkg.dev/${PROJECT_ID}/bp-dashboard/bp-dashboard:latest"
FRONTEND_MAX_INSTANCES="10"

# VITE_* build-time config baked into the SPA bundle — see the root
# Dockerfile's header comment and deploy/gcp.md's env matrix. VITE_API_URL
# itself is NOT set here: 09/10 always pass "/" explicitly (same-origin —
# see their own comments for why, and src/data/client.ts for the mechanism).
VITE_AUTH_PROVIDER="entra"        # dev (no real SSO) or entra — see src/auth/provider.ts
VITE_ENTRA_TENANT_ID=""           # same tenant as ENTRA_TENANT_ID above
VITE_ENTRA_CLIENT_ID=""           # the SPA's OWN app registration client ID (distinct from the API's — see deploy/gcp.md)
VITE_ENTRA_REDIRECT_URI=""        # left blank: src/auth/entra-provider.ts falls back to window.location.origin at
                                   # runtime, which is correct for 09's *.run.app URL (unknown until after its first
                                   # deploy). 10_deploy_loadbalancer.sh overrides this itself with https://$LB_DOMAIN/,
                                   # since that domain IS known ahead of time — no edit needed here for that path.
VITE_ENTRA_SCOPES="openid profile email"

# --- Load Balancer topology only (10_deploy_loadbalancer.sh) ---
# The domain you'll point at the reserved static IP (see that script's
# final output). Leave unset if you're only using 09's nginx-proxy topology.
LB_DOMAIN=""
