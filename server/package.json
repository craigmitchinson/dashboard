{
  "name": "ia-coe-dashboard-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Production data API for the Intelligent Automation dashboard: serves the SPA's ModelJson from SQL Server (Cloud SQL) and persists reference data server-side. See README.md for fixture-mode (no DB) instructions.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/cors": "^11.3.0",
    "fastify": "^5.12.1",
    "jose": "^5.9.6",
    "mssql": "^11.0.1",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0"
  },
  "devDependencies": {
    "@types/mssql": "^9.1.5",
    "@types/node": "^20.16.11",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
