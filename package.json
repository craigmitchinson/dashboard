{
  "name": "ia-coe-performance-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "data:mock": "node tools/generate-mock-data.mjs",
    "data:build": "node tools/build-dashboard-data.mjs",
    "data:all": "npm run data:mock && npm run data:build",
    "data:verify": "node tools/verify-economics.mjs",
    "data:validate": "node tools/validate-workqueue-csv.mjs",
    "docs:playbook": "node tools/build-playbook-md.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:parity": "vitest run tests/parity.test.ts"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
